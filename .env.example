# 复制为 .env 后按需修改（docker compose 会自动读取）
POSTGRES_USER=bid
POSTGRES_PASSWORD=bid_password
POSTGRES_DB=bid_inspection

API_PORT=8001
WEB_PORT=8888
ENVIRONMENT=production
SECRET_KEY=please-change-this-secret-in-production
CORS_ORIGINS=http://localhost:8888

# 首次启动是否生成演示项目（含 3 家企业、已解析文件和一次完整比对）
SEED_DEMO=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

MAX_UPLOAD_SIZE_MB=500

# 构建镜像时的 PyPI 源（海外环境可改为 https://pypi.org/simple）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
