# 复制为 .env 后按需修改（docker compose 会自动读取）
POSTGRES_USER=bid
POSTGRES_PASSWORD=bid_password
POSTGRES_DB=bid_inspection

API_PORT=8001
WEB_PORT=8888
ENVIRONMENT=production
SECRET_KEY=please-change-this-secret-in-production
CORS_ORIGINS=http://localhost:8888
# 文件预览 / SSE 使用的短期访问票据有效期（秒），不再把登录 JWT 放进 URL
SCOPED_TICKET_EXPIRE_SECONDS=300

# 首次启动是否生成演示项目（含 3 家企业、已解析文件和一次完整比对）
SEED_DEMO=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

MAX_UPLOAD_SIZE_MB=500

# OCR 识别（扫描件）：以下为部署级默认值，系统管理里的「OCR 识别」规则会覆盖它们。
# 调用方式：百度智能云 OCR 通用文字识别（标准含位置版）
# 文档：https://cloud.baidu.com/doc/OCR/s/vk3h7y58v
OCR_ENABLED=false
OCR_PROVIDER=baidu
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_LANGUAGE_TYPE=CHN_ENG
OCR_TIMEOUT_SECONDS=60
# 单次 OCR 上传的原始文件大小上限（MB）。超过时 PDF 会自动拆分成多个文件逐份上传。
# 百度接口对 base64 编码后的请求体限制 8MB，原始文件最大约 6MB。
OCR_MAX_FILE_MB=6

# 构建镜像时的 PyPI 源（海外环境可改为 https://pypi.org/simple）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
